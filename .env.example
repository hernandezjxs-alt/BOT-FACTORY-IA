# Copiar a .env en el entorno local y completar con credenciales propias.
# Nunca subir el archivo .env real al repositorio.

APP_ENV=development
APP_NAME=BOT FACTORY AI
LOG_LEVEL=INFO

# Supabase (dejar vacíos hasta configurar el proyecto)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (opcional en la etapa inicial)
REDIS_URL=

# Proveedores de IA (no incluir claves reales en Git)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram (no incluir tokens reales en Git)
TELEGRAM_BOT_TOKEN=
